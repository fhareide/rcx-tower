#!/bin/sh
# Release on tag: pushing a `v*` tag to this repo creates the same tag in the public
# fhareide/rcx-tower-releases repo, whose workflow then builds this repo at that tag and
# publishes the release there. Needs `gh` logged in.
#
# Install: cp tools/hooks/pre-push .git/hooks/pre-push

remote_url="$2"
releases=fhareide/rcx-tower-releases

case "$remote_url" in
  *fhareide/rcx-tower|*fhareide/rcx-tower.git) ;;
  *) exit 0 ;;
esac

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue  # deleting a tag
  tag="${remote_ref#refs/tags/}"

  if gh api "repos/$releases/git/ref/tags/$tag" > /dev/null 2>&1; then
    echo "pre-push: $releases already has $tag; not building it again." >&2
    continue
  fi
  head=$(gh api "repos/$releases/commits/main" --jq .sha) || {
    echo "pre-push: could not read $releases; push stopped. Use --no-verify to push without a release." >&2
    exit 1
  }
  gh api "repos/$releases/git/refs" -f "ref=refs/tags/$tag" -f "sha=$head" > /dev/null || {
    echo "pre-push: could not tag $releases with $tag; push stopped. Use --no-verify to push without a release." >&2
    exit 1
  }
  echo "pre-push: release build for $tag started: https://github.com/$releases/actions" >&2
done
exit 0
